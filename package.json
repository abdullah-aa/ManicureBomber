{
  "name": "manicure-bomber",
  "version": "1.0.0",
  "description": "Stealth Bomber flying over procedurally generated terrain using BabylonJS",
  "main": "index.js",
  "scripts": {
    "build": "webpack --mode=production && cp dist/index.html dist/*.js pages/ && cp dist/index.html dist/*.js ~/projects/ManicureBomber/",
    "dev": "webpack serve --mode=development",
    "start": "webpack serve --mode=development --open",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.3",
    "html-webpack-plugin": "^5.5.0",
    "prettier": "^3.6.2",
    "ts-loader": "^9.4.0",
    "typescript": "^5.0.0",
    "webpack": "^5.80.0",
    "webpack-cli": "^5.1.0",
    "webpack-dev-server": "^4.15.0"
  },
  "dependencies": {
    "@babylonjs/core": "^8.14.0",
    "@babylonjs/inspector": "^8.14.0"
  }
}
